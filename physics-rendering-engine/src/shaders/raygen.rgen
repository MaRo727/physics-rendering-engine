#version 460
#extension GL_EXT_ray_tracing : require

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1, rgba32f) uniform image2D outputImage;
layout(set = 0, binding = 2) uniform SceneUBO {
    mat4 invView;
    mat4 invProj;
    vec4 lightDir;
    vec4 lightColor;
    mat4 playerVP;
    vec4 ghostMode;   // .x = ghost active, .y = pry progress (0..1), .z = tool type (0=hands, 1=axe, 2=pickaxe, 3=hammer)
    vec4 debugInfo;   // .x = show debug UI, .y = biome (0-3), .z = hp%, .w = mana%
    vec4 debugInfo2;  // .x = level, .y = stamina%, .z = player x, .w = player z
    vec4 sunMoon;     // .xyz = sun direction, .w = sun altitude
    vec4 moonInfo;    // .xyz = moon direction, .w = moon altitude
    vec4 blizzardInfo; // .x = snow intensity (0..1), .y = time
    vec4 weatherInfo;  // .x = rain intensity, .y = fog density, .z = lightning flash, .w = cloud coverage
    vec4 windInfo;     // .x = wind strength, .y = wind dir x, .z = wind dir z, .w = weather time
} scene;

// ---------------------------------------------------------------------------
// UI SSBO — immediate-mode primitives uploaded each frame
// ---------------------------------------------------------------------------
//
// Layout (std430):
//   UiHeader   { count, screen_w, screen_h, _pad }   16 bytes
//   uint[192]  font_data  (96 glyphs × 2 uints)      768 bytes
//   UiPrim[]   primitives                              48 bytes each

struct UiPrim {
    vec4 rect;   // x, y, w, h (screen pixels)
    vec4 color;  // r, g, b, a
    uint glyph;  // 0 = solid rect, 32..127 = ASCII
    uint flags;  // bit 0 = 1px border
    uint _p1;
    uint _p2;
};

layout(set = 0, binding = 6, std430) buffer UiBuffer {
    uint ui_count;
    uint screen_w;
    uint screen_h;
    uint _pad;
    uint font_data[192];
    UiPrim prims[];
} ui;

layout(location = 0) rayPayloadEXT vec3 payload;

// ---------------------------------------------------------------------------
// 8×8 bitmap font sampling  (font data lives in the UI SSBO)
// ---------------------------------------------------------------------------

float sampleFont8(uint ascii, int px, int py) {
    if (ascii < 32u || ascii > 127u || px < 0 || px >= 8 || py < 0 || py >= 8)
        return 0.0;
    uint idx = (ascii - 32u) * 2u + uint(py / 4);
    uint word = ui.font_data[idx];
    uint row = (word >> (8u * uint(3 - py % 4))) & 0xFFu;
    return float((row >> uint(px)) & 1u);
}

// ---------------------------------------------------------------------------
// Render all UI primitives over the scene colour
// ---------------------------------------------------------------------------

vec3 renderUi(ivec2 pixel, vec3 col) {
    uint count = ui.ui_count;
    for (uint i = 0u; i < count; i++) {
        UiPrim p = ui.prims[i];

        float px = float(pixel.x);
        float py = float(pixel.y);

        // Hit test against the primitive's rectangle.
        float rx = p.rect.x;
        float ry = p.rect.y;
        float rw = p.rect.z;
        float rh = p.rect.w;

        if (px < rx || px >= rx + rw || py < ry || py >= ry + rh)
            continue;

        float alpha = p.color.a;

        if (p.glyph == 0u) {
            // Solid rectangle.
            // Border (flags bit 0)?
            if ((p.flags & 1u) != 0u) {
                float lx = px - rx;
                float ly = py - ry;
                if (lx < 1.0 || lx >= rw - 1.0 || ly < 1.0 || ly >= rh - 1.0) {
                    col = mix(col, vec3(0.4), alpha);
                    continue;
                }
            }
            col = mix(col, p.color.rgb, alpha);
        } else {
            // Glyph — sample the 8×8 bitmap.
            float lx = px - rx;
            float ly = py - ry;
            float scaleX = rw / 8.0;
            float scaleY = rh / 8.0;
            int gx = int(lx / scaleX);
            int gy = int(ly / scaleY);
            float hit = sampleFont8(p.glyph, gx, gy);
            if (hit > 0.5) {
                col = mix(col, p.color.rgb, alpha);
            }
        }
    }
    return col;
}

void main() {
    vec2 uv = (vec2(gl_LaunchIDEXT.xy) + 0.5) / vec2(gl_LaunchSizeEXT.xy);
    vec2 ndc = uv * 2.0 - 1.0;

    vec4 origin    = scene.invView * vec4(0.0, 0.0, 0.0, 1.0);
    vec4 target    = scene.invProj * vec4(ndc, 1.0, 1.0);
    vec4 direction = scene.invView * vec4(normalize(target.xyz / target.w), 0.0);

    payload = vec3(0.0);

    traceRayEXT(
        topLevelAS,
        gl_RayFlagsOpaqueEXT,
        0xFD, // skip shadow-only instances (mask bit 1)
        0,    // sbtRecordOffset
        1,    // sbtRecordStride
        0,    // missIndex
        origin.xyz,
        0.001,
        direction.xyz,
        10000.0,
        0     // payload location
    );

    // Volumetric 3D snowflakes — sample world-space positions along the ray.
    float snowIntensity = scene.blizzardInfo.x;
    if (snowIntensity > 0.0) {
        float time = scene.blizzardInfo.y;
        vec3 rayDir = normalize(direction.xyz);
        vec3 rayOrig = origin.xyz;

        float snowAccum = 0.0;

        for (int i = 0; i < 40; i++) {
            float depth = 0.8 + float(i) * 1.2;
            vec3 samplePos = rayOrig + rayDir * depth;

            // Animate: aggressive wind + falling.
            samplePos.x -= time * 8.0;
            samplePos.y += time * 2.5;
            samplePos.z -= time * 3.0;

            // Hash on a 3D grid.
            float cellSize = 0.7;
            vec3 cell = floor(samplePos / cellSize);
            vec3 frac_pos = fract(samplePos / cellSize);

            float h = fract(sin(dot(cell, vec3(127.1, 311.7, 74.7))) * 43758.5453);

            if (h > 0.82) {
                vec3 flakeCenter = vec3(
                    fract(sin(dot(cell, vec3(269.5, 183.3, 91.2))) * 76543.2109),
                    fract(sin(dot(cell, vec3(419.2, 371.9, 128.6))) * 32145.7890),
                    fract(sin(dot(cell, vec3(153.7, 287.4, 205.1))) * 54321.0987)
                );

                float d = length(frac_pos - flakeCenter);
                float flakeRadius = 0.12 + h * 0.12;

                if (d < flakeRadius) {
                    float brightness = 1.0 - d / flakeRadius;
                    float distFade = 1.0 - depth / 50.0;
                    snowAccum += brightness * distFade * 0.25;
                }
            }
        }

        snowAccum = min(snowAccum, 1.0) * snowIntensity;
        payload = mix(payload, vec3(0.92, 0.93, 0.96), snowAccum * 0.85);
    }

    // Volumetric rain streaks — thin vertical lines sampling world-space positions.
    float rainIntensity = scene.weatherInfo.x;
    if (rainIntensity > 0.0) {
        float wTime = scene.windInfo.w;
        float windStr = scene.windInfo.x;
        float windDirX = scene.windInfo.y;
        float windDirZ = scene.windInfo.z;
        vec3 rayDir = normalize(direction.xyz);
        vec3 rayOrig = origin.xyz;

        float rainAccum = 0.0;

        for (int i = 0; i < 48; i++) {
            float depth = 0.5 + float(i) * 0.9;
            vec3 samplePos = rayOrig + rayDir * depth;

            // Animate: fast falling + wind drift.
            samplePos.y += wTime * 12.0;
            samplePos.x -= wTime * windDirX * windStr * 6.0;
            samplePos.z -= wTime * windDirZ * windStr * 6.0;

            // Hash on a 3D grid — taller cells for vertical streaks.
            vec3 cellSize = vec3(0.4, 1.2, 0.4);
            vec3 cell = floor(samplePos / cellSize);
            vec3 frac_pos = fract(samplePos / cellSize);

            float h = fract(sin(dot(cell, vec3(127.1, 311.7, 74.7))) * 43758.5453);

            // Threshold: more rain = more streaks.
            float threshold = 1.0 - rainIntensity * 0.25;
            if (h > threshold) {
                // Streak center in XZ, full Y extent.
                vec2 streakCenter = vec2(
                    fract(sin(dot(cell, vec3(269.5, 183.3, 91.2))) * 76543.2109),
                    fract(sin(dot(cell, vec3(153.7, 287.4, 205.1))) * 54321.0987)
                );

                float dx = frac_pos.x - streakCenter.x;
                float dz = frac_pos.z - streakCenter.y;
                float distXZ = sqrt(dx * dx + dz * dz);
                float streakRadius = 0.06;

                if (distXZ < streakRadius) {
                    float brightness = (1.0 - distXZ / streakRadius) * 0.7;
                    float distFade = 1.0 - depth / 45.0;
                    rainAccum += brightness * max(distFade, 0.0) * 0.12;
                }
            }
        }

        rainAccum = min(rainAccum, 1.0) * rainIntensity;
        // Rain is a subtle blue-white tint.
        vec3 rainColor = vec3(0.7, 0.75, 0.85);
        payload = mix(payload, rainColor, rainAccum * 0.5);
    }

    // Lightning flash — bright white overlay.
    float lightningFlash = scene.weatherInfo.z;
    if (lightningFlash > 0.0) {
        payload = mix(payload, vec3(1.0, 0.98, 0.95), lightningFlash * 0.3);
    }

    // Crosshair overlay.
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    ivec2 center = ivec2(gl_LaunchSizeEXT.xy) / 2;
    ivec2 d = abs(pixel - center);
    int thickness = 1;
    int gap = 3;
    int arm = 10;
    bool onCross = (d.x <= thickness && d.y >= gap && d.y <= arm)
               || (d.y <= thickness && d.x >= gap && d.x <= arm);
    if (onCross) {
        payload = vec3(1.0);
    }

    // Pry progress arc around crosshair.
    float pryProgress = scene.ghostMode.y;
    if (pryProgress > 0.0) {
        vec2 off = vec2(pixel - center);
        float dist = length(off);
        float innerR = 14.0;
        float outerR = 18.0;
        if (dist >= innerR && dist <= outerR) {
            // Angle from top, clockwise: atan2 gives angle from +X, so rotate.
            float angle = atan(off.x, -off.y); // [-pi, pi], 0 = up
            float norm = (angle + 3.14159265) / (2.0 * 3.14159265); // [0,1] starting from bottom-left
            // Remap so 0 = top: shift by 0.5
            norm = fract(norm + 0.5);
            if (norm <= pryProgress) {
                payload = mix(payload, vec3(1.0, 0.9, 0.3), 0.9);
            }
        }
    }

    // Tool indicator — draw icon below crosshair when a tool is equipped.
    float toolType = scene.ghostMode.z;

    if (toolType > 0.5 && toolType < 1.5) {
        // Axe — orange crosshair + axe icon.
        if (onCross) { payload = vec3(1.0, 0.4, 0.2); }
        vec2 aOff = vec2(pixel - center) - vec2(0.0, 22.0);
        bool axeHandle = (abs(aOff.x) <= 1.0 && aOff.y >= -6.0 && aOff.y <= 6.0);
        bool axeBlade = (aOff.x >= 1.0 && aOff.x <= 6.0 && aOff.y >= -4.0 && aOff.y <= 2.0
                        && aOff.x - 1.0 <= 5.0 * (1.0 - abs(aOff.y - (-1.0)) / 4.0));
        if (axeHandle || axeBlade) {
            payload = mix(payload, vec3(0.9, 0.9, 0.9), 0.85);
        }
    } else if (toolType > 1.5 && toolType < 2.5) {
        // Pickaxe — brown crosshair + pick icon.
        if (onCross) { payload = vec3(0.7, 0.5, 0.2); }
        vec2 pOff = vec2(pixel - center) - vec2(0.0, 22.0);
        // Shaft (diagonal line).
        bool shaft = (abs(pOff.x - pOff.y) <= 1.5 && pOff.x >= -5.0 && pOff.x <= 5.0);
        // Head (horizontal bar at top-right).
        bool head = (pOff.y >= -6.0 && pOff.y <= -4.0 && pOff.x >= 1.0 && pOff.x <= 7.0);
        // Point (angled tip).
        bool point = (pOff.x >= 5.0 && pOff.x <= 7.0 && pOff.y >= -4.0 && pOff.y <= -2.0);
        if (shaft || head || point) {
            payload = mix(payload, vec3(0.8, 0.65, 0.4), 0.85);
        }
    } else if (toolType > 2.5) {
        // Hammer — blue crosshair + hammer icon.
        if (onCross) { payload = vec3(0.3, 0.6, 1.0); }
        vec2 hOff = vec2(pixel - center) - vec2(0.0, 22.0);
        // Handle (vertical line).
        bool handle = (abs(hOff.x) <= 1.0 && hOff.y >= -2.0 && hOff.y <= 6.0);
        // Head (thick rectangle at top).
        bool hammerHead = (abs(hOff.x) <= 5.0 && hOff.y >= -6.0 && hOff.y <= -2.0);
        if (handle || hammerHead) {
            payload = mix(payload, vec3(0.7, 0.8, 1.0), 0.85);
        }
    }

    // UI overlay — data-driven primitives from the UI SSBO.
    payload = renderUi(pixel, payload);

    imageStore(outputImage, ivec2(gl_LaunchIDEXT.xy), vec4(payload, 1.0));
}
